# Public build-time settings. Never put passwords, service-account keys or tokens here.
# Keep unconfirmed until the intended audience is decided.
# general enables configured integrations; children/unconfirmed keep them off.
VITE_MONETIZATION_AUDIENCE=unconfirmed

# Optional: your own GA4 web stream measurement ID, beginning with G-.
# Without it no analytics SDK is loaded or events transmitted.
VITE_GA_MEASUREMENT_ID=

# Optional: your own Google Ad Manager rewarded web unit, /network-code/ad-unit.
# An AdSense publisher ID, display slot, or AdMob app unit cannot replace this.
VITE_REWARDED_AD_UNIT_PATH=
